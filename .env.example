# ─── TikSave AI environment ─────────────────────────────────────────────
# Copy to .env and fill in what you need. The app runs without AI keys;
# AI features simply report as unavailable until a key is set.

TIKSAFE_ENV=development

# AI providers (optional — first available key wins)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Limits
TIKSAFE_MAX_UPLOAD_MB=200
TIKSAFE_MAX_DOWNLOAD_MB=500
TIKSAFE_RATE_LIMIT_PER_MINUTE=60

# Whisper model for transcription: tiny | base | small | medium | large
TIKSAFE_WHISPER_MODEL=small

# Timeouts (seconds)
TIKSAFE_REQUEST_TIMEOUT_SECONDS=60
TIKSAFE_EXTRACTION_TIMEOUT_SECONDS=45
TIKSAFE_FFMPEG_TIMEOUT_SECONDS=600

# Temp files older than this (seconds) are deleted by the cleanup job
TIKSAFE_TEMP_FILE_TTL_SECONDS=3600

# CORS (comma-separated, or * )
TIKSAFE_CORS_ORIGINS=*

# Streamlit frontend: point at a separately hosted API, or leave empty to
# auto-start a local backend subprocess.
TIKSAFE_API_URL=
